# 复制成 keystore.properties 再填自己的值。这个文件不会入库（见 .gitignore）。
#
# 生成签名：
#   keytool -genkeypair -v -keystore keystore/zcloud.jks -alias zcloud \
#           -keyalg RSA -keysize 2048 -validity 10950 \
#           -storepass 你的密码 -keypass 你的密码 \
#           -dname "CN=ZCloud AI, OU=Lab, O=ZCloud, L=Shanghai, ST=Shanghai, C=CN"
#
# 没有这个文件时 assembleRelease 会产出 app-release-unsigned.apk（装不上）。

storeFile=keystore/zcloud.jks
storePassword=change_me
keyAlias=zcloud
keyPassword=change_me
